{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-gpu",
        "preset": "desktop",
        "maxWaitForLoad": 45000
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "resource-summary:document:size": ["warn", { "maxNumericValue": 15000 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 380000 }],
        "resource-summary:stylesheet:size": ["warn", { "maxNumericValue": 80000 }],
        "resource-summary:image:size": ["warn", { "maxNumericValue": 500000 }],
        "resource-summary:third-party:count": ["warn", { "maxNumericValue": 2 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

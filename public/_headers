# Cache static assets for 1 year (immutable)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cache other assets for 1 month
/*.js
  Cache-Control: public, max-age=2592000
/*.css
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000

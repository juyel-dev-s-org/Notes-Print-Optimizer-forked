# Notes Print Optimizer - Environment Configuration
# Copy this file to .env.local and fill in your values.

# Google Apps Script Web App URL for feedback/Telegram notifications.
# Optional - the app works without this, feedback just won't be sent.
# Get this URL from: Deploy -> New deployment -> Web app (see GOOGLE_APPS_SCRIPT.md)
NEXT_PUBLIC_FEEDBACK_URL="YOUR_GAS_WEB_APP_URL_HERE"
